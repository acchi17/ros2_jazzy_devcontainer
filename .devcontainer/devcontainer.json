{
	// Dev Container name (not Container name)
	"name": "ros2_study",
	// Change the default user from root user
	"remoteUser": "vscode", 
	// Specify where in the Container to place the workspace opened in VSCode.
	"workspaceFolder": "/home/vscode/ros2_projects",
	// Mount setting
	"workspaceMount": "source=${localWorkspaceFolder},target=/home/vscode/ros2_projects,type=bind,consistency=cached",
	// Other settings
	"build": {
		"dockerfile": "Dockerfile"
	},
	"containerEnv": {
		"ROS_DOMAIN_ID": "30",
		// Use Zenoh instead of the default Fast DDS
		// so communication works across the WSL2/Docker Desktop NAT boundary
		// without needing WSL2 mirrored networking mode.
		"RMW_IMPLEMENTATION": "rmw_zenoh_cpp",
		"ZENOH_ROUTER_CONFIG_URI": "/home/vscode/ros2_projects/zenoh/pc_router_config.json5",
		// Default (peer) session config discovers the local router via
		// multicast scouting, which doesn't work reliably in this Docker
		// Desktop/WSL2 network — connect directly to it instead.
		"ZENOH_SESSION_CONFIG_URI": "/home/vscode/ros2_projects/zenoh/pc_session_config.json5"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-toolsai.jupyter", 
				"ms-toolsai.jupyter-keymap", 
				"ms-toolsai.jupyter-renderers"
			],
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"jupyter.alwaysTrustNotebooks": true
			}
		}
	},
	"postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/ros2_projects && mkdir -p /home/vscode/ros2_projects/ros2_ws/src"
}
