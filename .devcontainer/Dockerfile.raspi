# Download base image if it doesn't exist locally
FROM arm64v8/ros:jazzy-perception

# Install required packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    bash-completion \
    build-essential \
    cmake \
    gdb \
    git \
    locales \
    python3-colcon-common-extensions \
    python3-flake8 \
    python3-pip \
    python3-pytest-cov \
    python3-rosdep \
    python3-setuptools \
    python3-vcstool \
    python3-gpiozero \
    python3-lgpio \
    sudo \
    vim \
    wget \
    # Remove apt lists to keep image slim and ensure fresh indexes
    && rm -rf /var/lib/apt/lists/*

# Linux OS-level locale configuration
RUN locale-gen en_US en_US.UTF-8 && \
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8
ENV LANG en_US.UTF-8
ENV LC_ALL en_US.UTF-8

# Initialize rosdep
# * This command requires root privileges, so execute it before USER $USERNAME
# "|| true" is added to prevent build failure if already initialized or in CI environments
RUN rosdep init || true

# The base image already provides a non-root "ubuntu" user (uid/gid 1000), which matches
# the default first-user uid on Ubuntu/Raspberry Pi OS hosts. Reuse it instead of creating
# a separate user, and grant it sudo privileges.
ARG USERNAME=ubuntu
RUN usermod -aG sudo $USERNAME \
    && echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Create and set up ROS2 workspace
RUN mkdir -p /home/$USERNAME/work/ros2_ws/src \
    && echo "source /opt/ros/jazzy/setup.bash" >> /home/$USERNAME/.bashrc

# Set up colcon auto-completion, command history size, and history file size
RUN echo "source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash" >> /home/$USERNAME/.bashrc \
    && echo "export HISTSIZE=10000" >> /home/$USERNAME/.bashrc \
    && echo "export HISTFILESIZE=10000" >> /home/$USERNAME/.bashrc

# TurtleBot3 environment variable settings
#ENV TURTLEBOT3_MODEL=waffle_pi

# Set default user
USER $USERNAME

# Set working directory
WORKDIR /home/$USERNAME/work

CMD ["bash"]
