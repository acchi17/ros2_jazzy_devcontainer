{
	// Dev Container name (not Container name)
	"name": "ros2_main",
	// Change the default user from root user
	"remoteUser": "ubuntu",
	// Specify where in the Container to place the workspace opened in VSCode.
	"workspaceFolder": "/home/ubuntu/work",
	// Mount setting
	"workspaceMount": "source=${localWorkspaceFolder},target=/home/ubuntu/work,type=bind,consistency=cached",
	// Other settings
	"build": {
		"dockerfile": "Dockerfile"
	},
	"containerEnv": {
		"ROS_DOMAIN_ID": "30",
		"RMW_IMPLEMENTATION": "rmw_zenoh_cpp",
		"ZENOH_ROUTER_CONFIG_URI": "/home/ubuntu/work/zenoh/pc_router_config.json5",
		"ZENOH_SESSION_CONFIG_URI": "/home/ubuntu/work/zenoh/pc_session_config.json5"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-toolsai.jupyter", 
				"ms-toolsai.jupyter-keymap", 
				"ms-toolsai.jupyter-renderers"
			],
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"jupyter.alwaysTrustNotebooks": true
			}
		}
	},
	"postCreateCommand": "sudo chown -R ubuntu:ubuntu /home/ubuntu/work"
}
