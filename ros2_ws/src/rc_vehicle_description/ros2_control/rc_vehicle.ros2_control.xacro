<?xml version="1.0"?>
<!--
  ros2_control definition of the RC vehicle.

  Exposes the two logical joints used by bicycle_steering_controller:
    steering_joint/position  [rad]    (command + state)
    traction_joint/velocity  [rad/s]  (command + state)

  The hardware plugin is expected to be provided by rc_driver.
  Set use_mock_hardware:=true to run with mock_components/GenericSystem
  (commands are mirrored to states) until the real plugin is available.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rc_vehicle_ros2_control"
               params="name
                       hardware_plugin:=rc_driver/RcDriverHardware
                       use_mock_hardware:=false
                       max_steering_angle
                       max_traction_velocity">

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>${hardware_plugin}</plugin>
        </xacro:unless>
      </hardware>

      <!-- Virtual front steering joint: single steering-servo command -->
      <joint name="steering_joint">
        <command_interface name="position">
          <param name="min">${-max_steering_angle}</param>
          <param name="max">${max_steering_angle}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <!-- Virtual rear traction joint: single ESC/drive command -->
      <joint name="traction_joint">
        <command_interface name="velocity">
          <param name="min">${-max_traction_velocity}</param>
          <param name="max">${max_traction_velocity}</param>
        </command_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>
