{
  // Listen on all interfaces so local ROS 2 processes in this container
  // (connecting via pc_session_config.json5) can reach this router.
  listen: {
    endpoints: ["tcp/0.0.0.0:7447"],
  },
  // Connect out to the Raspberry Pi's Zenoh router. This is an outbound
  // connection, so it works even though the PC devcontainer sits behind
  // WSL2/Docker Desktop's NAT.
  // Replace <raspi-ip> with the Raspberry Pi's actual LAN IP (a static
  // IP or hostname is recommended so this doesn't need updating).
  connect: {
    endpoints: ["tcp/192.168.0.7:7447"],
  },
}
